rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products collection - Full access for authenticated users
    match /products/{productId} {
      allow read, write: if request.auth != null;
      
      // Validation rules for product data
      allow create: if request.auth != null &&
        isValidProduct(request.resource.data);
      
      allow update: if request.auth != null &&
        isValidProduct(request.resource.data);
    }
    
    // Inventory collection - Full access for authenticated users  
    match /inventory/{slotId} {
      allow read, write: if request.auth != null;
      
      // Validation for inventory updates
      allow update: if request.auth != null &&
        isValidInventoryUpdate(request.resource.data);
    }
    
    // Product History collection - For tracking deleted products
    match /product_history/{historyId} {
      allow read, write: if request.auth != null;
      
      // Allow creating history records
      allow create: if request.auth != null &&
        isValidProductHistory(request.resource.data);
    }
    
    // Machine Config collection - For machine configuration
    match /machine_config/{configId} {
      allow read, write: if request.auth != null;
    }
    
    // Sales collection - Read and create only
    match /sales/{saleId} {
      allow read: if request.auth != null;
      
      // Only allow creating sales (for ESP32), not updating/deleting
      allow create: if request.auth != null &&
        isValidSale(request.resource.data);
      
      // Admins can delete sales if needed
      allow delete: if request.auth != null;
    }
    
    // Machine status collection
    match /machine_status/{machineId} {
      allow read, write: if request.auth != null;
      
      // Validate machine status updates
      allow update: if request.auth != null &&
        isValidMachineStatus(request.resource.data);
    }
    
    // FIXED: Notifications collection - Real-time notifications with proper sync
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == request.resource.data.userId);
      
      // FIXED: Allow authenticated users to create notifications for themselves
      // This enables test notifications and system notifications to work properly
      allow create: if request.auth != null &&
        isValidNotification(request.resource.data) &&
        request.auth.uid == request.resource.data.userId;
      
      // FIXED: Users can update their own notifications (more flexible)
      // Allow updating read status, readAt, and other notification fields
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.userId &&
        isValidNotificationUpdate(request.resource.data, resource.data);
      
      // Users can delete their own notifications
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }
    
    // Analytics collection (if you add it later)
    match /analytics/{analyticsId} {
      allow read, write: if request.auth != null;
    }
    
    // Logs collection (optional - for system logs)
    match /logs/{logId} {
      allow read, write: if request.auth != null;
      
      // Allow creating logs but restrict massive log creation
      allow create: if request.auth != null &&
        request.resource.data.size() < 50; // Limit log entry size
    }
    
    // Users collection - For user preferences
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        userId == request.auth.uid;
    }
    
    // Helper functions for validation
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'slot', 'active']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price > 0 && data.price <= 1000 &&
             data.category is string && data.category.size() > 0 &&
             data.slot is string && data.slot.size() > 0 && data.slot.size() <= 50 &&
             data.active is bool;
    }
    
    function isValidInventoryUpdate(data) {
      return data.quantity is number && 
             data.quantity >= 0 && 
             data.quantity <= 200;
    }
    
    function isValidProductHistory(data) {
      return data.keys().hasAll(['slot', 'deletedProductName']) &&
             data.slot is string && data.slot.size() > 0 &&
             data.deletedProductName is string && data.deletedProductName.size() > 0;
    }
    
    function isValidSale(data) {
      return data.keys().hasAll(['productId', 'slot', 'price']) &&
             data.productId is string && data.productId.size() > 0 &&
             data.slot is string && data.slot.size() > 0 &&
             data.price is number && data.price > 0 && data.price <= 1000;
    }
    
    function isValidMachineStatus(data) {
      return data.keys().hasAny(['online', 'lastHeartbeat', 'wifiStrength', 'freeMemory', 'uptime']) &&
             (!('online' in data) || data.online is bool) &&
             (!('wifiStrength' in data) || (data.wifiStrength is number && data.wifiStrength >= -100 && data.wifiStrength <= 0)) &&
             (!('freeMemory' in data) || (data.freeMemory is number && data.freeMemory >= 0)) &&
             (!('uptime' in data) || (data.uptime is number && data.uptime >= 0));
    }
    
    // ENHANCED: Notification validation function
    function isValidNotification(data) {
      return data.keys().hasAll(['type', 'title', 'message', 'userId', 'timestamp']) &&
             data.type is string &&
             data.type in ['low_stock', 'out_of_stock', 'sale', 'stock_replenished', 'system'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
             data.userId is string && data.userId.size() > 0 &&
             data.timestamp is timestamp &&
             (!('priority' in data) || data.priority in ['low', 'medium', 'high']) &&
             (!('read' in data) || data.read is bool) &&
             (!('slot' in data) || (data.slot is string && data.slot.size() <= 50)) &&
             (!('productName' in data) || (data.productName is string && data.productName.size() <= 100)) &&
             (!('quantity' in data) || (data.quantity is number && data.quantity >= 0)) &&
             (!('price' in data) || (data.price is number && data.price >= 0));
    }
    
    // NEW: Notification update validation function
    function isValidNotificationUpdate(newData, existingData) {
      // Allow updating read status and readAt timestamp
      let allowedFields = ['read', 'readAt'].toSet();
      let changedFields = newData.diff(existingData).affectedKeys();
      
      // Check if only allowed fields are being updated
      return changedFields.hasOnly(allowedFields) &&
             // Validate the updated values
             (!('read' in newData) || newData.read is bool) &&
             (!('readAt' in newData) || newData.readAt is timestamp) &&
             // Ensure userId doesn't change
             newData.userId == existingData.userId;
    }
    
    // Allow all other collections for authenticated users (fallback)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}